FROM ubuntu:24.04

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        wget gnupg ca-certificates \
    && wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
        | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc >/dev/null \
    && echo "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-22 main" \
        > /etc/apt/sources.list.d/llvm.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        llvm-22 \
        llvm-22-dev \
        libmlir-22-dev \
        mlir-22-tools \
        clang-22 \
        cmake \
        ninja-build \
        python3 \
        libgtest-dev \
        zlib1g-dev \
        libzstd-dev \
        hyperfine \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang-22
ENV CXX=clang++-22

WORKDIR /workspace

COPY CMakeLists.txt ./
COPY lib/ lib/
COPY include/ include/
COPY tools/ tools/
COPY tests/ tests/
COPY external/ external/

RUN cmake -S . -B build-release -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DMLIR_DIR=/usr/lib/llvm-22/lib/cmake/mlir \
        -DLLVM_DIR=/usr/lib/llvm-22/lib/cmake/llvm \
    && cmake --build build-release --parallel "$(nproc)"

ENV PROTEUS_BUILD_DIR=build-release
ENV LLVM_PREFIX=/usr/lib/llvm-22
